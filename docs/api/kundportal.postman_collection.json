              "mode": "raw",
              "raw": "{\n  \"rubrik\": \"Faktura saknas\",\n  \"beskrivning\": \"Kunden har inte fått sin faktura.\",\n  \"kategori\": \"Fakturering\",\n  \"prioritet\": \"Hög\"\n}",
              "options": {
                "raw": {
                  "language": "json"
