          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Status is Nytt (R1)\", () => pm.expect(body.status).to.eql(\"Nytt\"));",
                  "pm.test(\"Has id and skapad\", () => {",
                  "  pm.expect(body.id).to.be.a(\"number\");",
                  "  pm.expect(Date.parse(body.skapad)).to.not.be.NaN;",
                  "});",
                  "pm.collectionVariables.set(\"arendeId\", body.id);"
                ]
              }
            }
          ]
